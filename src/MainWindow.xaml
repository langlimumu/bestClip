<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BestClip;assembly=BestClip"
        Title="BestClip"
        Width="780" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <local:KindGlyphConverter x:Key="KindGlyph"/>
        <local:KindBrushConverter x:Key="KindBrush"/>
        <local:KindBackgroundConverter x:Key="KindBg"/>
        <local:ThumbnailBrushConverter x:Key="ThumbBrush"/>
        <local:TimeAgoConverter x:Key="TimeAgo"/>
        <local:BoolToVisibilityConverter x:Key="BoolVis"/>
        <local:StringToVisibilityConverter x:Key="StringVis"/>
        <local:PinOpacityConverter x:Key="PinOpacity"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B7CFF" Offset="0"/>
            <GradientStop Color="#4DA3FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#101219" Offset="0"/>
            <GradientStop Color="#0C0E14" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#98A2B5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#818CA1"/>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#6F7A8E"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#D7DCE6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#F2F5FA"/>
            <Setter Property="CaretBrush" Value="#8B7CFF"/>
            <Setter Property="SelectionBrush" Value="#667C6CFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipItemContainer" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="12" Margin="0,0,0,4"
                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent"
                                Padding="10,0">
                            <Grid>
                                <Border x:Name="Accent" Width="3" CornerRadius="2" Margin="0,14"
                                        HorizontalAlignment="Left" Background="{StaticResource AccentGradient}"
                                        Opacity="0"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#167C6CFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#337C6CFF"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClipList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2,2,2"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ClipItemContainer}"/>
            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2EFFFFFF" CornerRadius="3" Margin="1,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ClipItemTemplate">
            <Grid Height="66" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="42" Height="42" VerticalAlignment="Center">
                    <Border CornerRadius="11" Background="{Binding Kind, Converter={StaticResource KindBg}}"/>
                    <TextBlock Text="{Binding Kind, Converter={StaticResource KindGlyph}}"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                               Foreground="{Binding Kind, Converter={StaticResource KindBrush}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Rectangle RadiusX="10" RadiusY="10"
                               Fill="{Binding Thumbnail, Converter={StaticResource ThumbBrush}}"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource BoolVis}}"/>
                </Grid>

                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="#EDF1F7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SourceLabel}" FontSize="11" Foreground="#7D879C"/>
                        <TextBlock Text="  ·  " FontSize="11" Foreground="#4C5568"/>
                        <TextBlock Text="{Binding CreatedUtc, Converter={StaticResource TimeAgo}}"
                                   FontSize="11" Foreground="#7D879C"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MetaText}" FontSize="10.5" Foreground="#5F697E"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE842;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="#A99CFF" VerticalAlignment="Center"
                               ToolTip="已固定"
                               Opacity="{Binding Pinned, Converter={StaticResource PinOpacity}}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#171A23"/>
            <Setter Property="BorderBrush" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HasDropShadow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6EAF2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                           Foreground="#697386" Margin="28,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#14FFFFFF" Margin="8,5"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="Card" Margin="16" CornerRadius="18"
                Background="{StaticResource CardBackground}"
                BorderBrush="#1FFFFFFF" BorderThickness="1"
                RenderTransformOrigin="0.5,0.42">
            <Border.Effect>
                <DropShadowEffect BlurRadius="38" ShadowDepth="9" Opacity="0.55" Color="#000000"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="CardTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Ellipse Width="460" Height="180" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Margin="0,-88,0,0" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#2E7C6CFF" Offset="0"/>
                            <GradientStop Color="#007C6CFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <Grid x:Name="HeaderArea" Grid.Row="0" Margin="22,0,16,0" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradient}"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="#7C6CFF"/>
                            </Border.Effect>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BestClip" FontSize="16.5" FontWeight="SemiBold" Foreground="#F7F9FC"/>
                            <TextBlock Text="剪贴板历史 · 随取随用" FontSize="10.5" Foreground="#6D7789" Margin="0,3,0,0"/>
                        </StackPanel>

                        <Border x:Name="PausedBadge" Grid.Column="3" Visibility="Collapsed"
                                Background="#1FF3C06B" BorderBrush="#40F3C06B" BorderThickness="1"
                                CornerRadius="7" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="5" Height="5" Fill="#F3C06B" VerticalAlignment="Center"/>
                                <TextBlock Text="已暂停" FontSize="10" Foreground="#F3C06B" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="SettingsButton" Grid.Column="4" Style="{StaticResource IconButton}"
                                ToolTip="设置" AutomationProperties.Name="设置">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/>
                        </Button>

                        <Button x:Name="CloseButton" Grid.Column="5" Style="{StaticResource IconButton}"
                                ToolTip="隐藏" AutomationProperties.Name="隐藏窗口" Margin="2,0,0,0">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Margin="22,0,22,10" Height="46" CornerRadius="12"
                            Background="#0BFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1">
                        <Grid Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" Foreground="#7A8498" VerticalAlignment="Center"/>

                            <Grid Grid.Column="1" Margin="9,0,8,0">
                                <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                         AutomationProperties.Name="搜索剪贴板内容"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索剪贴板内容…"
                                           FontSize="12.5" Foreground="#5C6679" VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>

                            <Button x:Name="ClearSearchButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                    Width="22" Height="22" Visibility="Collapsed" ToolTip="清除搜索"
                                    AutomationProperties.Name="清除搜索" Margin="0,0,6,0">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
                            </Button>

                            <Border Grid.Column="3" Background="#0FFFFFFF" CornerRadius="6" Padding="8,4"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="HotkeyBadge" Text="Ctrl + Shift + V" FontSize="10"
                                           Foreground="#7F8A9F"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="22,0,22,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ChipAll" Tag="all" Style="{StaticResource Chip}">
                                <TextBlock Text="全部" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border x:Name="ChipText" Tag="text" Style="{StaticResource Chip}">
                                <TextBlock Text="文本" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border x:Name="ChipImage" Tag="image" Style="{StaticResource Chip}">
                                <TextBlock Text="图片" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border x:Name="ChipFiles" Tag="files" Style="{StaticResource Chip}">
                                <TextBlock Text="文件" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border x:Name="ChipPinned" Tag="pinned" Style="{StaticResource Chip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="9.5" Foreground="#9A8CFF" VerticalAlignment="Center" Margin="0,1,4,0"/>
                                    <TextBlock Text="收藏" Style="{StaticResource ChipText}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Button x:Name="ClearHistoryButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource LinkButton}" Content="清空历史"
                                AutomationProperties.Name="清空历史"/>
                    </Grid>

                    <Grid Grid.Row="3" Margin="14,0,10,0">
                        <ListBox x:Name="ClipList" Style="{StaticResource ClipList}"
                                 ItemTemplate="{StaticResource ClipItemTemplate}"
                                 AutomationProperties.Name="剪贴板历史"
                                 SelectionMode="Single"/>

                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False" Visibility="Collapsed">
                            <Border Width="66" Height="66" CornerRadius="20" Background="#0EFFFFFF"
                                    BorderBrush="#14FFFFFF" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="25" Foreground="#7C6CFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="还没有剪贴板记录" FontSize="14"
                                       Foreground="#A8B2C4" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                            <TextBlock x:Name="EmptyHint" Text="复制文字、图片或文件后，会自动出现在这里"
                                       FontSize="11" Foreground="#606B7E" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="24,0,20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#0FFFFFFF" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="↑↓" FontSize="9" Foreground="#8D97AA"/>
                            </Border>
                            <TextBlock Text="选择" FontSize="10" Foreground="#5E687B" Margin="5,0,14,0"/>
                            <Border Background="#0FFFFFFF" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="Enter" FontSize="9" Foreground="#8D97AA"/>
                            </Border>
                            <TextBlock Text="粘贴" FontSize="10" Foreground="#5E687B" Margin="5,0,14,0"/>
                            <Border Background="#0FFFFFFF" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="Ctrl+P" FontSize="9" Foreground="#8D97AA"/>
                            </Border>
                            <TextBlock Text="固定" FontSize="10" Foreground="#5E687B" Margin="5,0,14,0"/>
                            <Border Background="#0FFFFFFF" CornerRadius="4" Padding="5,2">
                                <TextBlock Text="Del" FontSize="9" Foreground="#8D97AA"/>
                            </Border>
                            <TextBlock Text="删除" FontSize="10" Foreground="#5E687B" Margin="5,0,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="10.5" Foreground="#667085" Text="共 0 条"/>
                    </Grid>
                </Grid>

                <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,56" Background="#F21A1E28" BorderBrush="#337C6CFF" BorderThickness="1"
                        CornerRadius="10" Padding="14,9" Opacity="0" Visibility="Collapsed"
                        Panel.ZIndex="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="#7C6CFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToastText" Text="已复制" FontSize="11.5" Foreground="#E9EDF5"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
