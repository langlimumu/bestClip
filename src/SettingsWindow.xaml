<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BestClip 设置"
        Width="560" Height="700"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B7CFF" Offset="0"/>
            <GradientStop Color="#4DA3FF" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBackground" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#101219" Offset="0"/>
            <GradientStop Color="#0C0E14" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#98A2B5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="BorderBrush" Value="#12FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6F7A8E"/>
            <Setter Property="Margin" Value="3,0,0,9"/>
        </Style>

        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="#E9EDF4"/>
        </Style>

        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#6B7588"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="23" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="11.5" Background="#24FFFFFF"/>
                            <Ellipse x:Name="Knob" Width="17" Height="17" Fill="#A9B2C2"
                                     HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#7C6CFF"/>
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#818CA1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="7" Padding="11,5"
                                Background="#0AFFFFFF" BorderThickness="1" BorderBrush="#14FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#227C6CFF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#557C6CFF"/>
                                <Setter Property="Foreground" Value="#D6D0FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentGradient}"
                                Padding="20,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FF8093"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="#14FF6B81" BorderBrush="#40FF6B81"
                                BorderThickness="1" Padding="13,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FF6B81"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Width="8">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#2EFFFFFF" CornerRadius="3" Margin="1,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Border x:Name="Card" Margin="16" CornerRadius="18"
                Background="{StaticResource CardBackground}"
                BorderBrush="#1FFFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="38" ShadowDepth="9" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="24,0,16,0" x:Name="HeaderArea" Background="Transparent">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Foreground="#F7F9FC"/>
                        <TextBlock Text="让 BestClip 更符合你的习惯" FontSize="10.5" Foreground="#6D7789" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource IconButton}" ToolTip="关闭" AutomationProperties.Name="关闭设置">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,0,4">
                    <StackPanel Margin="24,2,24,10">
                        <TextBlock Text="快捷键" Style="{StaticResource SectionTitle}"/>
                        <Border Style="{StaticResource Panel}" Padding="16,14,16,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="呼出 BestClip" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="在任意应用中唤出历史面板" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <Border x:Name="HotkeyBox" Grid.Column="1" Width="172" Height="38"
                                            Background="#0FFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                            CornerRadius="9" VerticalAlignment="Center" Margin="0,0,0,2"
                                            AutomationProperties.Name="全局快捷键，点击重新录制">
                                        <TextBlock x:Name="HotkeyText" Text="Ctrl + Shift + V" FontSize="12"
                                                   Foreground="#DDE3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="HotkeyHint" Text="点击右侧快捷键可重新录制，按 Esc 取消"
                                           FontSize="10" Foreground="#5E6879" Margin="0,10,0,0"/>
                                <TextBlock x:Name="HotkeyError" FontSize="10.5" Foreground="#FF8093"
                                           Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="行为" Style="{StaticResource SectionTitle}" Margin="3,16,0,9"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="自动粘贴" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="选择记录后，自动向前台应用发送 Ctrl+V" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoPasteSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#0EFFFFFF" Margin="0,13"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="登录 Windows 后在后台常驻，随时按快捷键呼出" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="AutoStartSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#0EFFFFFF" Margin="0,13"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="忽略密码管理器" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="不记录 KeePass、1Password 等工具复制的敏感内容" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="IgnorePasswordSwitch" Grid.Column="1" Style="{StaticResource Switch}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="历史记录" Style="{StaticResource SectionTitle}" Margin="3,16,0,9"/>
                        <Border Style="{StaticResource Panel}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="最大保存条数" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="固定（收藏）的记录不会被自动清理" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <StackPanel x:Name="MaxItemsPanel" Grid.Column="1" Orientation="Horizontal"
                                                VerticalAlignment="Center"/>
                                </Grid>

                                <Border Height="1" Background="#0EFFFFFF" Margin="0,13"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="清空全部历史" Style="{StaticResource RowTitle}"/>
                                        <TextBlock Text="删除所有记录和图片缓存，此操作无法撤销" Style="{StaticResource RowHint}"/>
                                    </StackPanel>
                                    <Button x:Name="ClearAllButton" Grid.Column="1" Content="清空历史"
                                            Style="{StaticResource DangerButton}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="24,0,20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="BestClip 1.1.2" FontSize="10" Foreground="#5F697B"/>
                        <TextBlock Text="  ·  " FontSize="10" Foreground="#3E4758"/>
                        <TextBlock FontSize="10">
                            <Hyperlink x:Name="GitHubLink" NavigateUri="https://github.com/langlimumu/bestClip"
                                       Foreground="#8B7CFF" TextDecorations="None">GitHub</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="  ·  " FontSize="10" Foreground="#3E4758"/>
                        <TextBlock FontSize="10">
                            <Hyperlink x:Name="DataLink" NavigateUri="file:///"
                                       Foreground="#8B7CFF" TextDecorations="None">数据目录</Hyperlink>
                        </TextBlock>
                        <TextBlock Text="  ·  " FontSize="10" Foreground="#3E4758"/>
                        <TextBlock FontSize="10">
                            <Hyperlink x:Name="UpdateLink" NavigateUri="https://github.com/langlimumu/bestClip/releases/latest"
                                       Foreground="#8B7CFF" TextDecorations="None">检查更新</Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="SaveError" FontSize="10.5" Foreground="#FF8093"
                                   VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <Button x:Name="SaveButton" Content="保存" Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="保存设置" Width="92" Height="38"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
